# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#
# Create a bot and copy its token from:
#   https://discord.com/developers/applications -> your app -> Bot -> Reset Token
# No privileged gateway intents are needed; leave them all off.
DISCORD_BOT_TOKEN=your-bot-token-here
# Alternatively, read the token from a file (for example a mounted Kubernetes Secret) instead of
# the environment; set only one of the two:
#DISCORD_BOT_TOKEN_FILE=/run/secrets/discord/token

# --- Optional overrides -----------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
#LOG_LEVEL=INFO

# When set, application (slash) commands sync instantly to this one guild
# instead of globally. Use your dev server's ID. Global sync can take up to an
# hour to propagate, so this is recommended during development.
#DEV_GUILD_ID=123456789012345678

# Log format: "text" (default, human-readable) or "json" (one object per line, for Loki etc.).
#LOG_FORMAT=text

# Sync slash commands at every start. Only for a single self-hosted process: with more than one
# process or revision the last writer wins. In production, run `aha sync` once per release.
#SYNC_ON_STARTUP=false

# Presence: shown as "Listening to /help" while online. BOT_ACTIVITY=off shows no activity;
# BOT_ACTIVITY_TYPE is playing, listening, watching or competing; BOT_STATUS is online, idle,
# dnd or invisible. Presence needs no privileged intent.
#BOT_ACTIVITY=/help
#BOT_ACTIVITY_TYPE=listening
#BOT_STATUS=online

# Health/readiness/metrics HTTP server (/livez, /readyz, /metrics). Loopback by default; bind
# 0.0.0.0 only inside a pod network. HEALTH_PORT=0 disables the server.
#HEALTH_BIND=127.0.0.1
#HEALTH_PORT=8080
